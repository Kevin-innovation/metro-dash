{
  "name": "metro-dash",
  "private": true,
  "version": "2.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "node scripts/check-names.mjs && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build:vercel": "node scripts/check-names.mjs && convex deploy --cmd 'vite build'",
    "check:ui": "node scripts/ui-check.mjs",
    "test:e2e": "playwright test",
    "audit": "node scripts/fairness-audit.mjs 40 420",
    "check": "node scripts/check-names.mjs"
  },
  "dependencies": {
    "convex": "^1.44.0",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "convex-test": "^0.0.55",
    "playwright": "^1.62.1",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
