# Online mode. Leave this unset and the game runs entirely on local storage —
# guests can play, but there is no leaderboard and no cloud save.
#
# `npx convex dev` writes the real value into .env.local for you.
VITE_CONVEX_URL=

# Set in the Convex dashboard (Settings -> Environment Variables), NOT here:
#   ADMIN_KEY   long random string, gates the teacher tools in convex/admin.js
